#!/bin/sh
# Usage: scripts/worktree-sync
# On main, fast-forward to origin/main. On any other branch, rebase onto origin/main.
set -eu
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$(dirname "$0")/lib.sh"

[ $# -eq 0 ] || usage "usage: worktree-sync (takes no arguments)"
need_repo
branch=$(current_branch)
require_clean
git fetch -q origin main

if [ "$branch" = main ]; then
	git merge -q --ff-only origin/main || die "main has diverged from origin/main; fix it by hand"
else
	git rebase -q origin/main ||
		die "rebase stopped on a conflict; resolve it and run git rebase --continue"
fi
printf '%s: %s is up to date with origin/main\n' "$prog" "$branch"
